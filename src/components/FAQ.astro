---
import { faq } from '../content';
---

<section class="section-pad bg-eco-light text-eco-ink" aria-labelledby="faq-title" id="faq">
  <div class="container-narrow max-w-3xl">
    <h2 id="faq-title" class="heading-display mb-10 text-3xl text-eco-ink sm:text-4xl">
      {faq.title}
    </h2>
    <div class="space-y-3">
      {
        faq.items.map((item, i) => (
          <details
            class="group rounded-2xl border border-eco-primary/15 bg-white/80 open:shadow-soft"
            open={i === 0}
          >
            <summary
              class="cursor-pointer list-none px-5 py-4 font-display text-lg font-bold marker:content-none sm:px-6 sm:text-xl [&::-webkit-details-marker]:hidden"
            >
              <span class="flex items-start justify-between gap-4">
                <span>{item.q}</span>
                <span
                  class="mt-1 shrink-0 text-eco-primary transition group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </span>
            </summary>
            <div class="space-y-3 whitespace-pre-line px-5 pb-5 leading-relaxed text-eco-ink/75 sm:px-6">
              {item.a}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
