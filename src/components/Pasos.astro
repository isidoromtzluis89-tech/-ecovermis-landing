---
import { pasos } from '../content';
---

<section class="section-pad bg-eco-light text-eco-ink" aria-labelledby="pasos-title">
  <div class="container-narrow">
    <h2 id="pasos-title" class="heading-display mb-12 text-3xl text-eco-ink sm:text-4xl">
      Cómo funciona
    </h2>

    <div class="mb-16">
      <h3 class="mb-8 font-display text-xl font-bold text-eco-primary sm:text-2xl">
        {pasos.fertilizante.title}
      </h3>
      <ol class="grid gap-10 md:grid-cols-3 md:gap-8">
        {
          pasos.fertilizante.steps.map((step, i) => (
            <li>
              <div class="mb-4 overflow-hidden rounded-2xl">
                <img
                  src={step.image.src}
                  alt={step.image.alt}
                  width="600"
                  height="600"
                  class="aspect-[4/3] w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <p class="mb-2 font-display text-4xl font-black text-eco-field">{i + 1}</p>
              <h4 class="heading-display mb-2 text-lg text-eco-ink sm:text-xl">{step.title}</h4>
              <p class="leading-relaxed text-eco-ink/75">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="rounded-3xl border border-eco-primary/15 bg-white/70 p-8 shadow-soft sm:p-10">
      <h3 class="mb-6 font-display text-xl font-bold text-eco-primary sm:text-2xl">
        {pasos.taller.title}
      </h3>
      <ol class="mb-6 grid gap-6 sm:grid-cols-3">
        {
          pasos.taller.steps.map((step, i) => (
            <li>
              <p class="mb-1 font-display text-sm font-bold uppercase tracking-widest text-eco-field">
                Paso {i + 1}
              </p>
              <h4 class="heading-display mb-1 text-lg text-eco-ink">{step.title}</h4>
              <p class="text-eco-ink/75">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="text-eco-ink/75">{pasos.taller.note}</p>
    </div>
  </div>
</section>
