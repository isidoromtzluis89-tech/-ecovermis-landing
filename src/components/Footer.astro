---
import { footer, site, whatsappHref } from '../content';
---

<footer class="border-t border-eco-secondary/20 bg-eco-bg section-pad py-12 sm:py-14">
  <div class="container-narrow flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
    <div class="flex items-center gap-4">
      <img
        src={site.logo.src}
        alt={site.logo.alt}
        width="72"
        height="84"
        class="h-14 w-auto"
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="heading-display text-xl text-eco-secondary">{footer.brand}</p>
        <p class="mt-0.5 text-muted">{footer.tagline}</p>
      </div>
    </div>
    <p>
      <span class="text-muted">{footer.contactLabel}: </span>
      <a
        href={whatsappHref()}
        target="_blank"
        rel="noopener noreferrer"
        class="font-display font-bold text-eco-accent underline-offset-4 hover:underline"
      >
        {site.whatsappDisplay}
      </a>
    </p>
  </div>
</footer>
